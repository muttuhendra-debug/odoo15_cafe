<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_cafe_order_tree" model="ir.ui.view">
        <field name="name">cafe.order.tree</field>
        <field name="model">cafe.order</field>
        <field name="arch" type="xml">
            <tree string="Cafe Orders" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="order_time"/>
                <field name="customer_name"/>
                <field name="table_number"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'loaded'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cafe_order_form" model="ir.ui.view">
        <field name="name">cafe.order.form</field>
        <field name="model">cafe.order</field>
        <field name="arch" type="xml">
            <form string="Cafe Order">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,loaded,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_name"/>
                            <field name="mobile_phone"/>
                            <field name="table_number"/>
                        </group>
                        <group>
                            <field name="order_time"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Menu Orders">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="barcode"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cafe_order_search" model="ir.ui.view">
        <field name="name">cafe.order.search</field>
        <field name="model">cafe.order</field>
        <field name="arch" type="xml">
            <search string="Search Cafe Orders">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="table_number"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'draft')]"/>
                <filter string="In POS Cart" name="loaded" domain="[('state', '=', 'loaded')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Table" name="table_number" context="{'group_by': 'table_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cafe_order" model="ir.actions.act_window">
        <field name="name">Cafe Orders</field>
        <field name="res_model">cafe.order</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cafe_order_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada pesanan cafe.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_cafe_root" name="Cafe" sequence="10"/>
    <menuitem id="menu_cafe_order" name="Menu Orders" parent="menu_cafe_root" action="action_cafe_order" sequence="10"/>
</odoo>
