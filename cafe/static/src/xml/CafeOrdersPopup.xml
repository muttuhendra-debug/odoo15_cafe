<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="CafeOrdersPopup" owl="1">
        <div role="dialog" class="modal-dialog">
            <div class="popup popup-selection cafe-orders-popup" style="max-width: 650px; width: 90%;">
                <header class="title bg-primary text-white p-3 rounded-top">
                    <t t-esc="props.title"/>
                </header>
                <main class="body p-3" style="max-height: 400px; overflow-y: auto;">
                    <div class="list-group">
                        <t t-foreach="props.orders" t-as="order" t-key="order.id">
                            <div class="list-group-item list-group-item-action p-3 mb-2 border rounded"
                                 t-att-class="{'active text-white bg-primary': state.selectedOrder and state.selectedOrder.id === order.id}"
                                 t-on-click="selectOrder(order)" style="cursor: pointer;">
                                <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                    <h5 class="mb-1 font-weight-bold">
                                        <t t-esc="order.name"/> - <t t-esc="order.customer_name"/>
                                    </h5>
                                    <span class="badge badge-warning p-2">
                                        Meja: <t t-esc="order.table_number"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between text-muted"
                                     t-att-class="{'text-white': state.selectedOrder and state.selectedOrder.id === order.id}">
                                    <small><t t-esc="order.lines ? order.lines.length : 0"/> Item Menu</small>
                                    <strong class="text-teal" style="font-size: 16px;">
                                        <t t-esc="formatAmount(order.amount_total)"/>
                                    </strong>
                                </div>
                            </div>
                        </t>
                    </div>
                </main>
                <footer class="footer p-3 d-flex justify-content-end gap-2 border-top">
                    <button class="button cancel btn btn-secondary me-2" t-on-click="cancel">
                        <t t-esc="props.cancelText"/>
                    </button>
                    <button class="button confirm btn btn-primary" t-att-disabled="!state.selectedOrder" t-on-click="confirm">
                        <t t-esc="props.confirmText"/>
                    </button>
                </footer>
            </div>
        </div>
    </t>
</templates>
